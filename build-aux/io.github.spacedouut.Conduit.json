{
    "id": "io.github.spacedouut.Conduit",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm20"
    ],
    "command": "conduit",
    "finish-args": [
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--share=ipc",
        "--filesystem=xdg-run/pipewire-0"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm20/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm20/lib",
        "no-debuginfo": true,
        "build-args": [
            "--share=network"
        ]
    },
    "modules": [
        {
            "name": "Conduit",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "../",
                    "skip": [
                        ".git",
                        ".flatpak",
                        ".flatpak-builder",
                        ".flatpak-build",
                        "target"
                    ]
                }
            ]
        }
    ]
}
